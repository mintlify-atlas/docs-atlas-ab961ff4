  "keyFeatures": [
    "Simplex method (Big-M) for linear programming with 2–5 decision variables",
    "Graphical visualization of 2-variable LP feasible regions and optimal points",
    "Binary integer programming via Branch & Bound with full B&B tree output",
    "Pure integer programming via Branch & Bound with variable bounding",
    "Single-variable unconstrained optimization via Bisection (derivative root-finding)",
    "Single-variable unconstrained optimization via Newton-Raphson",
    "Multivariable gradient descent/ascent for unconstrained optimization",
    "Graphical method for 2–3 variable unconstrained functions with surface/volume plots",
    "Karush-Kuhn-Tucker (KKT) conditions solver for constrained nonlinear programming",
    "Interactive React 18 frontend with step-by-step tableau display and Plotly charts",
    "FastAPI backend with Pydantic v2 validation and auto-generated Swagger/ReDoc docs"
  ],
  "publicApiSurface": [
    "POST /api/v1/simplex/solve",
    "GET  /api/v1/simplex/health",
    "POST /api/v1/binary/solve",
    "GET  /api/v1/binary/health",
